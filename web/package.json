{
  "name": "infiro-public-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321 --ignore-lock",
    "build": "NODE_ENV=production ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "NODE_ENV=production ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "check:browser": "node tests/browser.mjs",
    "test": "node --test tests/data.test.mjs",
    "test:platform-state": "node tests/platform-state-browser.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
