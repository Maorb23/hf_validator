---
import Site from '../../layouts/Site.astro';
import PageIntro from '../../components/PageIntro.astro';
const demos=[['/demo/search','Search strategy playground','Replay actual TPE, Gaussian-process, and random sampler observations. Compare two objectives and two seeds.','01','RECORDED SIMULATION'],['/demo/pareto','The inference tradeoff','Change a latency ceiling, inspect Pareto points, and compare configurations within a workload.','02','SYNTHETIC DATA'],['/demo/journey','A model’s journey','Follow evidence from discovery through pinned selection, execution, and optimization.','03','ARCHITECTURE WALKTHROUGH'],['/demo/studies','Recorded run replay','Replay imported inference runs, inspect throughput and p95 latency, and disclose missing provenance.','04','RECORDED MEASUREMENTS']];
---
<Site title="Interactive inference lab"><PageIntro title="Explore the decisions behind inference." text="Understand search behavior, serving tradeoffs, and the model journey through interactive examples. No account, API key, or GPU required."/><section class="section demo-gallery">{demos.map(([href,title,text,num,kind])=><a class="demo-card" href={href}><div class="demo-card-art" aria-hidden="true">{num==='01'?<svg viewBox="0 0 400 160">{Array.from({length:9},(_,i)=><ellipse cx="200" cy="80" rx={20+i*19} ry={10+i*8} transform="rotate(-18 200 80)" fill="none" stroke="#a7f3cf" opacity={1-i*.09}/>)}</svg>:num==='02'?<svg viewBox="0 0 400 160"><path d="M45 135Q100 45 170 39T360 24" fill="none" stroke="#a7f3cf" strokeWidth="2"/>{Array.from({length:22},(_,i)=><circle cx={55+(i*73)%280} cy={50+(i*37)%90} r="3" fill="#81b9ff"/>)}</svg>:<span>{num==='03'?'Research · Execute · Compare':'Revision · Runtime · Workload'}</span>}</div><h2>{title}</h2><p>{text}</p><div class="demo-card-footer"><span>{kind}</span><span aria-hidden="true">Explore </span></div></a>)}</section><section class="section content-section"><h2>Real algorithms. Honest boundaries.</h2><p class="lede">The lab includes offline simulations and recorded inference measurements. Simulations are labeled separately; measured runs retain their source context and disclose missing metadata. No demo establishes model compatibility or a performance advantage.</p><a href="/methodology" class="text-button">Read the methodology </a></section></Site>
