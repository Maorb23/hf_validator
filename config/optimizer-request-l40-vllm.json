{
  "model": "Qwen/Qwen3-4B",
  "frameworks": ["vllm"],
  "gpu_type": "gpu-h100-sxm",
  "gpu_count": 1,
  "preset": "1gpu-16vcpu-200gb",
  "images": {
    "vllm": "docker.io/maorb23/llm-optimizer-vllm:pruning-20261015T120303Z"
  },
  "bucket": "hf-model-watch",
  "prefix": "llm-optimizer",
  "client_args": [
    "dataset_name=random;random_input_len=128;random_output_len=32;random_range_ratio=1.0;num_prompts=16;output_details=true"
  ],
  "server_args": {
    "vllm": ["max_num_seqs=[8,16]"]
  },
  "search_strategy": "optuna",
  "optuna": {
    "trials": 2,
    "seed": 7
  },
  "timeout_minutes": 120,
  "preemptible": true,
  "dry_run": false
}
