{
  "images": {
    "vllm": "docker.io/maorb23/llm-optimizer-vllm:pruning-20261015T120303Z"
  },
  "bucket": "hf-model-watch",
  "prefix": "llm-optimizer",
  "preset": "1gpu-16vcpu-200gb",
  "timeout_minutes": 120,
  "preemptible": true,
  "dry_run": false,
  "server_args": {
    "vllm": [
      "async_scheduling*no_async_scheduling:(bool,bool)=[[False,True],[True,False]]",
      "performance_mode=['balanced','interactivity','throughput']",
      "attention_backend=['auto','FLASH_ATTN','FLASHINFER']",
      "kv_cache_dtype=['auto','fp8']",
      "enable_prefix_caching*no_enable_prefix_caching:(bool,bool)=[[False,True],[True,False]]",
      "compilation_config=['{\"cudagraph_mode\":\"NONE\"}', '{\"cudagraph_mode\":\"PIECEWISE\"}', '{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\"}']",
      "max_num_batched_tokens=range(1024,32769,256)",
      "max_num_seqs=range(8,129,8)"
    ]
  },
  "optuna": {
    "trials": 30,
    "sampler": "TPESampler",
    "sampler_kwargs": {
      "multivariate": true,
      "group": true
    },
    "pruner": "NopPruner",
    "seed": 7
  }
}
