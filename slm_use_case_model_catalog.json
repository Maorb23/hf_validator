  "lookup_guidance": {
    "normalize": "Unicode casefold; replace punctuation, underscores, and hyphens with spaces; collapse repeated whitespace.",
    "strategy": [
      "Prefer exact use_case ID where supplied.",
      "Otherwise match complete aliases after normalization.",
      "Use keyword overlap to retrieve a shortlist, not as a sufficient condition to choose a single use case.",
      "If multiple use cases match or there is no confident match, apply semantic retrieval over use_case, aliases, and examples or ask the agent to disambiguate."
    ],
    "important": "Do not grep the model names or size fields to infer task intent. Matching is descriptive only; check deployment constraints and benchmark candidate models before selection."
  },
