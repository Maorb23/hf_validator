+def check_runtime_backend(request, framework):
+    # TRT can silently fall back to MMHA when FlashInfer is unavailable.
+    # Check dispatch inside the serving environment before starting a Gemma trial.
+    if request.model != "google/gemma-4-12B-it" or framework != "trtllm":
+        return
+    code = (
+        "from tensorrt_llm._torch.attention_backend.utils import get_attention_backend; "
+        "backend = get_attention_backend('FLASHINFER'); "
+        "\nif backend.__name__ != 'FlashInferAttention':\n"
+        "    raise RuntimeError('Gemma requires FlashInferAttention; fallback is prohibited')"
+    )
+    subprocess.run([sys.executable, "-c", code], check=True)
+
+
+def cache_model_assets(request):
+    """Warm the shared HF cache at the approved commit; never fetch weights."""
+    from huggingface_hub import snapshot_download
+    return snapshot_download(
+        request.model, revision=request.revision,
+        allow_patterns=["*.json", "*.model", "*.tiktoken", "*.txt", "*.jinja"],
+    )
 
 
