# Local execution
UV_CACHE_DIR=.uv-cache
HF_MODEL_WATCH_CONFIG_DIR=config
HF_MODEL_WATCH_STORAGE_URI=artifacts
HF_MODEL_WATCH_WORKER_OUTPUT_DIR=artifacts
HF_MODEL_WATCH_WORKSPACE_DIR=.worker_workspace
HF_MODEL_WATCH_PAYLOAD_JSON=

# Hugging Face
HF_TOKEN=
HF_HOME=.cache/huggingface
TRANSFORMERS_CACHE=.cache/huggingface/transformers
HF_MODEL_WATCH_ALLOW_GATED=false
HF_MODEL_WATCH_ALLOW_TRUST_REMOTE_CODE=false
HF_MODEL_WATCH_MAX_MODELS_TO_SCAN=100
HF_MODEL_WATCH_MAX_CANDIDATES_TO_RUN=3
HF_MODEL_WATCH_MAX_PARAMS_BILLION=30

# Worker/controller dry-run
DRY_RUN=true
HF_MODEL_WATCH_DRY_RUN=true
HF_MODEL_WATCH_WORKER_DRY_RUN=true
HF_MODEL_WATCH_OBJECT_STORE_DRY_RUN=true

# Worker payload inputs
RUN_ID=
MODEL_ID=sshleifer/tiny-gpt2
MODEL_REVISION=
CONFIG_B64=
PAYLOAD_JSON_B64=

# S3-compatible artifact storage
AWS_S3_BUCKET=
AWS_S3_PREFIX=hf-model-watch
AWS_ENDPOINT_URL_S3=https://storage.eu-north1.nebius.cloud
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Nebius controller/service-account auth
NB_PROFILE_NAME=hf-model-watch-controller
NB_PROJECT_ID=
NEBIUS_CONFIG_YAML_B64=
NEBIUS_SERVICE_ACCOUNT_KEY_B64=
SA_ID=
PUBLIC_KEY_ID=
NEBIUS_PRIVATE_KEY_B64=
NEBIUS_PRIVATE_KEY_PATH=

# Optional experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=hf-model-watch
