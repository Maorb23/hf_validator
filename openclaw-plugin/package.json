{
  "name": "@hf-model-watch/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17 <2027"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
