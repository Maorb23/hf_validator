{
  "id": "hf-model-watch",
  "name": "Hugging Face Model Watch",
  "description": "Restricted conversational access to hf-model-watch recommendations.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["projectRoot"],
    "properties": {
      "projectRoot": {"type": "string", "minLength": 1},
      "pythonExecutable": {"type": "string", "minLength": 1},
      "stateRoot": {"type": "string", "minLength": 1},
      "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 600000}
    }
  },
  "activation": {"onStartup": true},
  "contracts": {
    "tools": [
      "recommend_models",
      "provide_recommendation_input",
      "select_model",
      "record_model_feedback",
      "revise_recommendation",
      "get_run_status"
    ]
  }
}
